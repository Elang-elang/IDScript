dari "Python.idsm" impor {
    impor,
    evaluasi sebagai _eval
};

dari "Konsol.idsm" impor { format };

dari "Galat.idsm" impor { Galat };

dari "Kamus.idsm" impor { Kamus };

konst FileName: Teks = "<idscript input>";

konst _Helper: Apapun = impor("IDScript").Interpreter;
konst _AST: Apapun = impor("IDScript").IDSNodes;

konst Interp: Apapun = _Helper.make_interpreter();

publik fungsi evaluasi(raw_code: Teks): Apapun {
    final copy_interp: Apapun = salin Interp;
    
    final code: Teks = format("fungsi utama(): Apapun { kembalikan({}) }", raw_code);
    
    var ast: Apapun;
    coba {
        ast = _Helper.ast(code);
    } tangkap (err) {
        kesalahan Galat(format("Kode '{}' bukanlah sebuah ekspresi dan ada kesalahan", raw_code));
    }
    (*copy_interp).Program(ast);
    kembalikan (*copy_interp).current_scope.get("utama")();
}

publik fungsi jalankan_berkas(code: Teks, file: Teks): Kosong {
    final ast: Apapun = _Helper.ast(code, file);
    Interp.Program(ast);
}

publik fungsi jalankan(code: Teks): Kosong {
    jalankan_berkas(code, FileName);
}

publik fungsi lingkup(): Apapun {
    kembalikan Kamus(Interp.current_scope._GlobalScope__scope.copy());
}
