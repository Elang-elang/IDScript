dari "Konsol.idsm" impor { publik format, publik println };

struktur Mahasiswa {
    publik nama: Teks,
    publik umur: Angka,
    publik aktif: Boolean
}

implementasi Mahasiswa {
    publik metode perkenalan(ini: Mahasiswa): Teks {
        kembalikan "Halo, saya " + ini.nama;
    }
    publik metode info_umur(ini: Mahasiswa): Teks {
        kembalikan "Umur: " + format("{}", [ini.umur]);
    }
    publik metode status(ini: Mahasiswa): Teks {
        jika (ini.aktif) { kembalikan "Aktif"; }
        kembalikan "Tidak Aktif";
    }
}

fungsi utama(): Angka {
    final mhs: Mahasiswa = Mahasiswa { nama: "Budi", umur: 20, aktif: benar };
    println(mhs.perkenalan());
    println(mhs.info_umur());
    println("Status: " + mhs.status());
    kembalikan 0;
}
